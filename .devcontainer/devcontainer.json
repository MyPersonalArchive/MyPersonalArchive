// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "my-personal-archive-dev",
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspaces/MyPersonalArchive",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24.11.0"
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": true,
			"installDockerBuildx": true,
			"version": "latest",
			"dockerDashComposeVersion": "v2"
		}
		// "features": {
		// 	"ghcr.io/devcontainers/features/sshd:1.1.0": {}
		// }
	},
	"containerEnv": {
		"ASPNETCORE_ENVIRONMENT": "Development",
		"ASPNETCORE_HTTP_PORTS": "5054",
		"ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
		"CERTIFICATE_PASSWORD": "${localEnv:MPA_CertificatePassword:-}",

		"Keycloak__Admin__Username": "${localEnv:KEYCLOAK_ADMIN_USERNAME:-}",
		"Keycloak__Admin__Password": "${localEnv:KEYCLOAK_ADMIN_PASSWORD:-}",

		"Keycloak__BaseUrl": "${localEnv:KEYCLOAK_ORG_ADMIN_API_BASE_URL:-}",
		"Keycloak__Authority": "${localEnv:KEYCLOAK_ORG_ADMIN_API_AUTHORITY:-}",
		"Keycloak__Realm": "${localEnv:KEYCLOAK_ORG_ADMIN_API_REALM:-}",
		"Keycloak__ClientId": "${localEnv:KEYCLOAK_ORG_ADMIN_API_CLIENT_ID:-}",
		"Keycloak__ClientSecret": "${localEnv:KEYCLOAK_ORG_ADMIN_API_CLIENT_SECRET:-}",

		"Oidc__BackchannelAuthority": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_BACKCHANNEL_AUTHORITY:-}",
		"Oidc__BrowserAuthority": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_BROWSER_AUTHORITY:-}",
		"Oidc__Realm": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_REALM:-}",
		"Oidc__ClientId": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_CLIENT_ID:-}",
		"Oidc__ClientSecret": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_CLIENT_SECRET:-}",
		"Oidc__CallbackPath": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_CALLBACK_PATH:-}",
		"Oidc__SignedOutCallbackPath": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_SIGNED_OUT_CALLBACK_PATH:-}",
		"Oidc__DefaultRedirectPath": "${localEnv:KEYCLOAK_MY_PERSONAL_ARCHIVE_DEFAULT_REDIRECT_PATH:-}",

		"JWT__JwtSecret": "${localEnv:LOCAL_AUTH_JWTSECRET:-}",
		"JWT__JwtIssuer": "${localEnv:LOCAL_AUTH_JWTISSUER:-}",
		"JWT__Audience": "${localEnv:LOCAL_AUTH_AUDIENCE:-}"
	},
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/data/mpa,target=/data,type=bind,consistency=cached"
	],
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		5173
	],
	"portsAttributes": {
		"5173": {
			"protocol": "https",
			"onAutoForward": "notify",
			"label": "React Application"
		}
	},
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "dotnet restore",	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit",
				"josefpihrt-vscode.roslynator",
				"eamodio.gitlens",
				"ms-azuretools.vscode-docker",
				"github.vscode-pull-request-github",
				"humao.rest-client",
				"cweijan.vscode-database-client2",
				"bradlc.vscode-tailwindcss",
				"mermaidchart.vscode-mermaid-chart",
				"dotjoshjohnson.xml",
				"anthropic.claude-code"
			]
		}
	},
	"postCreateCommand": "chmod u=+rwx .devcontainer/*.sh && .devcontainer/setup-environment.sh && .devcontainer/setup-shell.sh && .devcontainer/setup-project.sh",
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root"
}