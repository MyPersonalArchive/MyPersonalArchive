### Variables — edit these for your environment
@keycloak-host = {{$processEnv Keycloak__BaseUrl}}
@realm = {{$processEnv Keycloak__Realm}}
@org-id = c4569ed4-5f56-42c5-b939-82beb819c7b7
@client-id = {{$processEnv Keycloak__ClientId}}
@client-secret = {{$processEnv Keycloak__ClientSecret}}


### 1. Test — get a token with client_credentials
# @name getServiceToken
POST {{keycloak-host}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{client-id}}&client_secret={{client-secret}}&grant_type=client_credentials


### 2. List all organizations (to find your org ID)
GET {{keycloak-host}}/admin/realms/{{realm}}/organizations
Authorization: Bearer {{getServiceToken.response.body.access_token}}
Accept: application/json


### 3. List members of an organization
# Uses the access_token captured from the previous request
GET {{keycloak-host}}/admin/realms/{{realm}}/organizations/{{org-id}}/members?briefRepresentation=false
Authorization: Bearer {{getServiceToken.response.body.access_token}}
Accept: application/json


### 4. List all groups in the organization
GET {{keycloak-host}}/admin/realms/{{realm}}/organizations/{{org-id}}/groups
Authorization: Bearer {{getServiceToken.response.body.access_token}}
Accept: application/json


### 5. List members of a specific org group
@group-id = f069e571-d301-45d5-8c6c-8b35d6da1138
GET {{keycloak-host}}/admin/realms/{{realm}}/organizations/{{org-id}}/groups/{{group-id}}/members
Authorization: Bearer {{getServiceToken.response.body.access_token}}
Accept: application/json

