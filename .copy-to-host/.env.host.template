## Host (non-devcontainer) variant of .env.template for: op run --env-file=.env.host.template -- ...
# Unlike .env.template, names are already the app's own configuration keys, so no devcontainer
# "remoteEnv" mapping is needed. Non-secret values are literals; only secrets come from 1Password.
# NOTE: URLs point at the host-published Keycloak ports, not at the compose service name.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5054
CERTIFICATE_PASSWORD=pass

# Keycloak admin API (organization management)
Keycloak__BaseUrl=https://localhost:8443
Keycloak__Realm=my-personal-archive
Keycloak__ClientId=org-admin-api
Keycloak__ClientSecret=op://MpaDevelopment/org-admin-api/client-secret

# OIDC login. Callback paths must match the client's redirect URIs in
# .copy-to-host/realm-export.json (https://localhost:5054/api/signin-oidc).
Oidc__Enabled=true
Oidc__BackchannelAuthority=https://localhost:8443/realms/my-personal-archive
Oidc__BrowserAuthority=https://localhost:8443
Oidc__ClientId=my-personal-archive
Oidc__ClientSecret=op://MpaDevelopment/my-personal-archive/client-secret
Oidc__CallbackPath=/api/signin-oidc
Oidc__SignedOutCallbackPath=/api/signout-callback-oidc
Oidc__DefaultRedirectPath=/

# Local bearer tokens
Jwt__JwtSecret=op://MpaDevelopment/mpa-local-auth/JWT Secret
Jwt__JwtIssuer=op://MpaDevelopment/mpa-local-auth/JWT Issuer
Jwt__Audience=op://MpaDevelopment/mpa-local-auth/Audience
