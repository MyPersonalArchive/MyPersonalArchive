<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Backend.Core</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" Version="10.0.1" />

		<PackageReference Include="NetVips" Version="3.0.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<!-- The container images provide libvips built from source (see docker/build-libvips.sh). This
		     supplies native binaries as a convenience when developing on a Windows host only. It is the
		     reduced "web" variant of libvips and lacks several loaders enabled in the containers, notably
		     PDF (poppler) and HEIC (libde265/x265), so PDF previews are unavailable on Windows.
		     Linux builds (e.g. the Docker image) are unaffected by this condition. -->
		<PackageReference Include="NetVips.Native.win-x64" Version="8.13.2" />
	</ItemGroup>

</Project>
